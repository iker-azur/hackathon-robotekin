# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Logs (simulation runs write large ones)
*.log

# Trained models: 0.6-1.1 GB each, recreated by the training scripts
demos/**/models/

# Generated datasets: recreated exactly by demos/03_command_model/generate_dataset.py (fixed seed)
# and laya/laya_prepare.py. Kept in git: stats.md, test_real.jsonl (hand-written) and
# train_asr.jsonl (speech-recognition samples, not exactly reproducible).
demos/03_command_model/data/train_commands.jsonl
demos/03_command_model/data/train_item_kinds.jsonl
demos/03_command_model/data/eval_commands.jsonl
demos/03_command_model/data/eval_item_kinds.jsonl
demos/03_command_model/data/test_unseen.jsonl
demos/03_command_model/data/*.pt

# Per-sentence error dumps, regenerated by evaluate.py (the *_report.md files are kept)
demos/03_command_model/results/*_errors.jsonl

# Captured camera frames and per-frame scene JSON, written by
# demos/04_perception/09_camera_to_scene.py. Kept in git: the
# results/*_report.md summaries and out/calibration/calibration.json.
demos/04_perception/out/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
