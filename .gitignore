# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Logs (simulation runs write large ones)
*.log

# Trained models: 0.6-1.1 GB each, recreated by the training scripts
demos/**/models/

# Generated datasets: recreated exactly by demos/03_command_model/generate_dataset.py (fixed seed)
# and laya/laya_prepare.py. Kept in git: stats.md, test_real.jsonl (hand-written) and
# train_asr.jsonl (speech-recognition samples, not exactly reproducible).
demos/03_command_model/data/train_commands.jsonl
demos/03_command_model/data/train_item_kinds.jsonl
demos/03_command_model/data/eval_commands.jsonl
demos/03_command_model/data/eval_item_kinds.jsonl
demos/03_command_model/data/test_unseen.jsonl
demos/03_command_model/data/*.pt

# Per-sentence error dumps, regenerated by evaluate.py (the *_report.md files are kept)
demos/03_command_model/results/*_errors.jsonl

# Captured camera frames and per-frame scene JSON, written by
# demos/04_perception/09_camera_to_scene.py. Kept in git: the
# results/*_report.md summaries and out/calibration/calibration.json.
demos/04_perception/out/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
demos/05_planner_and_executor/out11/

# Demo 12 measurement artifacts and the Vite install. The measurements are *regenerated* by
# demos/07_multi_robot_orchestration/demo12/tools/ (probe_grasp_pose.py, probe_grasp.py),
# which is why they are ignored rather than committed: a JSON in the tree is a claim, and a
# probe you can re-run is evidence. Their measured conclusions are written up by hand in
# demos/07_multi_robot_orchestration/demo12/docs/PHYSICS.md, which *is* committed.
demos/07_multi_robot_orchestration/out12/
demos/07_multi_robot_orchestration/demo12/web/node_modules/
demos/07_multi_robot_orchestration/demo12/web/dist/

# Demo 17 (demos/08_recovery_kit): generated .kit experience files (machine-specific
# absolute paths) and raw perception frames (15 MB, re-captured by tools/capture_perception.py).
demos/08_recovery_kit/out/
demos/08_recovery_kit/results/perception_frames/

# Pytest caches (every demo has one)
.pytest_cache/

# Demo 11 sweep runs: transient stdout (*.out), "finished" markers (*.done) and throwaway
# launcher scripts (run_*.sh); the JSON reports are what matter
demos/05_planner_and_executor/results/*.out
demos/05_planner_and_executor/results/*.done
demos/05_planner_and_executor/results/run_*.sh
# Benchmark JSON written to demos/results/ when a tool is launched from demos/ with a relative --output
demos/results/

# Demo 18 (demos/09_voice_bin_picking): recorded datasets, checkpoints and run output are
# ignored by that folder's own .gitignore; its measured reports in results/ are kept.

