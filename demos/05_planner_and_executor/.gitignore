# Local ignore for this demo only, so the repository root .gitignore stays untouched.
# __pycache__/ and demos/**/models/ are already covered by the root file.

# Captured frames, annotated overlays and per-frame scene JSON, written by
# 10_command_to_motion.py. Kept in git: the results/*_report.md summaries.
out/

# Datasets regenerated exactly by command_model_v2/generate_dataset.py (fixed seed).
# Kept in git: stats.md, test_real.jsonl (hand-written) and tests/.
data/*.jsonl
data/*.pt
data/*.md
!data/test_real.jsonl

# Per-sentence error dumps, regenerated by command_model_v2/evaluate.py.
results/*_errors.jsonl