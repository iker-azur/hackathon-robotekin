# Local ignore for this demo only, so the repository root .gitignore stays untouched.
# __pycache__/ and demos/**/models/ are already covered by the root file.
#
# Paths here are relative to demos/05_planner_and_executor/. The generated dataset lives in
# command_model_v2/data/, NOT in data/ - an earlier version of this file said `data/*.jsonl`,
# which resolved to a directory that does not exist and silently ignored nothing, so a 28 MB
# train_commands.jsonl was about to be committed.

# Captured frames, annotated overlays and per-frame scene JSON, written by
# 10_command_to_motion.py. Kept in git: the results/*_report.md summaries and
# out/calibration/calibration.json.
out/

# Datasets regenerated exactly by command_model_v2/generate_dataset.py (fixed seed), and the
# two subsets derived from test_real.jsonl by command_model_v2/build_test_set.py.
# Kept in git: stats.md and test_real.jsonl, which are the only ones not reproducible.
#
# Note the negations come first on purpose. An earlier version of this file listed
# `command_model_v2/data/stats.md` without the `!`, so it ignored the file its own comment
# two lines above said was kept, and stats.md was silently left untracked.
command_model_v2/data/*.jsonl
command_model_v2/data/*.pt
!command_model_v2/data/stats.md
!command_model_v2/data/test_real.jsonl

# Per-sentence error dumps, regenerated by command_model_v2/evaluate.py.
# The *_report.md summaries are kept, as they are in demos/03_command_model.
command_model_v2/results/*_errors.jsonl

# Per-sentence error dumps of the shape-model runs (command_model_v2/results/<run>/*_errors.jsonl).
command_model_v2/results/**/*_errors.jsonl

# Shape dataset, regenerated by command_model_v2/generate_dataset.py. stats.md is kept.
command_model_v2/data_shapes/*.jsonl

# Measurement output of the benchmark and probe tools (tools/*.py write them to results/).
# Hundreds of runs, ~350 MB: each one is regenerated by the tool that wrote it, and the
# conclusions are written by hand in the results/*.md reports, which are kept. The few JSON
# files already tracked stay tracked.
results/*.json
results/*.png
results/*.txt

# Test and tool caches
.pytest_cache/
